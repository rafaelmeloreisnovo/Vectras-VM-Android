<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="com.termux.rafacodephi.permission.RUN_COMMAND" />
    <queries>
        <package android:name="com.termux.rafacodephi" />
    </queries>
    <!--
      Android 10 W^X boundary: targetSdk 29+ cannot execve code copied into the
      writable app home. APK Wizard debug builds therefore let PackageManager
      extract lib/<abi>/lib*.so entries into ApplicationInfo.nativeLibraryDir.
      The Omega carrier is audited as ET_EXEC/no-DT_NEEDED; the .so suffix is a
      package-manager carrier convention, not a shared-library dependency.
    -->
    <application android:extractNativeLibs="true">
        <receiver
            android:name="com.vectras.vm.integration.VectrasTermuxResultReceiver"
            android:exported="false" />
    </application>
</manifest>
