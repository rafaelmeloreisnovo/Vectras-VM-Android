#.idea/navEditor.xml
.kotlin/

# Keystore files
# Uncomment the following lines if you do not want to check your keystore files in.
*.jks
*.keystore

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# Google Services (e.g. APIs or Firebase)
google-services.json

# Freeline
freeline.py
freeline/
freeline_project_description.json

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/readme.md

# Version control
vcs.xml

# lint
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/
# lint/reports/

README.html

# Sensitive signing and credentials artifacts
*.jks
*.keystore
*.p12
*.pfx
secrets.*
credentials.*
# Local Android SDK/toolchain bootstrap artifacts
.android-sdk/
.build-spill/

# Python bytecode cache
__pycache__/
*.py[cod]
*.pyo


# Local fork sync cache (downloaded via termux orchestrator)
.third_party_forks/

# RAFAELIA/QEMU binary-exodus: generated or external artifacts only.
# Keep source, manifests, hashes and build recipes in git; keep blobs out.
app/src/main/assets/roms/*.img
app/src/main/assets/roms/*.fd
app/src/main/assets/roms/*.bin
app/src/main/assets/alpine19/*.tar
app/src/main/assets/bootstrap/*.tar
app/src/main/jniLibs/**/*.so
3dfx/*.iso
Incluir/*.zip
Incluir/*.docx
.ci/*.zip
*.qcow2
*.raw
*.7z
*.rar
qemu_rafaelia_build/
qemu_rafaelia_artifacts/
build_vos_test/

# Local beta artifact matrix outputs (APKs/AABs/manifests/hashes/temporary beta keystores).
artifacts/local-matrix/
